<!-- week 6: Final Project - My Reviews View -->

<h1><%= title %></h1>

<% if (typeof messages !== 'undefined' && messages) { %>
  <%- messages() %>
<% } %>

<main class="my-reviews">
  <% if (reviews && reviews.length > 0) { %>
    <% reviews.forEach(review => { %>
      <div class="review-card">
        <h3><%= review.inv_year %> <%= review.inv_make %> <%= review.inv_model %></h3>
        <p class="rating">Rating: <%= '⭐'.repeat(review.review_rating) %></p>
        <p class="review-text"><%= review.review_text %></p>
        <p class="review-date">Posted: <%= new Date(review.review_date).toLocaleDateString() %></p>
        <div class="review-actions">
          <a href="/reviews/edit/<%= review.review_id %>">Edit</a>
          <a href="/reviews/delete/<%= review.review_id %>" onclick="return confirm('Are you sure?')">Delete</a>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p>You haven't written any reviews yet.</p>
  <% } %>
</main>